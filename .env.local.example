# Mongo connection for the control plane (users, businesses, entitlements).
MONGODB_URI=
MONGODB_DB_NAME=

# NextAuth v5 session signing key. Generate with: npx auth secret
AUTH_SECRET=

# OpenAI. Leave OPENAI_API_KEY blank to run every AI surface on its fallback
# copy — the app builds, runs and demos with no key configured.
OPENAI_API_KEY=
# Model per job. The fast tier does the per-message triage, which is the only
# workload that scales with usage. Check current pricing before changing these.
OPENAI_MODEL_FAST=
OPENAI_MODEL_REASONING=
# Hard ceiling on tokens per business per calendar month. Reaching it degrades
# every surface to its fallback copy rather than failing.
OPENAI_MONTHLY_TOKEN_BUDGET=

# Company-controlled Gmail account AEGIS retrieves mail from. Leave blank and
# Mail runs on the seeded sample inbox, and every status surface reports the
# mailbox as DISCONNECTED rather than pretending otherwise.
GMAIL_ACCOUNT=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Meta (Facebook/Instagram) ads. Leave blank and the Ads screens run on stored
# records seeded from the design, reported as DISCONNECTED on the status screen.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
