# Mongo connection for the control plane (users, businesses, entitlements).
MONGODB_URI=
MONGODB_DB_NAME=

# NextAuth v5 session signing key. Generate with: npx auth secret
AUTH_SECRET=

# OpenAI. Leave OPENAI_API_KEY blank to run every AI surface on its fallback
# copy — the app builds, runs and demos with no key configured.
OPENAI_API_KEY=
# Model per job. The fast tier does the per-message triage, which is the only
# workload that scales with usage. Check current pricing before changing these.
OPENAI_MODEL_FAST=
OPENAI_MODEL_REASONING=
# Hard ceiling on tokens per business per calendar month. Reaching it degrades
# every surface to its fallback copy rather than failing.
OPENAI_MONTHLY_TOKEN_BUDGET=

# Encrypts stored credentials (mailbox app passwords, Meta access tokens)
# before they are stored (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Without it a mailbox cannot be connected at all; rotating it makes every
# already-stored mailbox unreadable, and each must be reconnected.
MAIL_CREDENTIAL_KEY=

# Meta ads and the Messenger Page are connected per business in Business
# Management, not here; those tokens are stored encrypted under
# MAIL_CREDENTIAL_KEY, like a mailbox password.

# Messenger webhook. The app secret is how AEGIS proves a delivery really came
# from Meta (App settings -> Basic -> App Secret); the verify token is a random
# string you also type into Meta when registering the webhook.
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
